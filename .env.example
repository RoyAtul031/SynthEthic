# ===================================================
# SynthEthic Environment Configuration
# Decentralized Privacy-Preserving Synthetic Data Generator
# ===================================================

# Service Settings
PORT=8000
HOST=0.0.0.0
STREAMER_PORT=8080
FRONTEND_PORT=3000

# Cryptographic Salt for Ingestion Noise-Encoding
ENTROPY_SALT=synthethic_entropy_salt_2026

# Differential Privacy Bounds
DEFAULT_EPSILON=1.0
DEFAULT_DELTA=0.00001
DEFAULT_CLIP_NORM=1.0
DEFAULT_NOISE_MECHANISM=gaussian

# Generative GAN Parameters
DEFAULT_EPOCHS=30
DEFAULT_BATCH_SIZE=64
DEFAULT_LATENT_DIM=32
DEFAULT_LEARNING_RATE=0.002

# Storage Configuration
STORAGE_TYPE=local # options: local, postgres, minio
DATABASE_URL=postgresql://synthethic:synthpass2026@localhost:5432/synthethic_db

# MinIO / S3 Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=synthethic-datasets
